COORDINATOR_URL=https://api-production-cc9f.up.railway.app
WORKER_ACCESS_TOKEN=
WORKER_NAME=friend-worker-1

# Runtime-generated compatibility field. Detection overwrites this value; do not select capabilities manually.
WORKER_CAPABILITIES=

# Public jobs are anonymous and can consume local/API/subscription capacity. Explicit opt-in only.
ACCEPT_PUBLIC_REQUESTS=false

# Local Hermes-style command center. Loopback only; no inbound internet port.
WORKER_AUTO_START=true
DASHBOARD_PORT=4317
DASHBOARD_AUTO_OPEN=true

# Codex subscription capability. Anthropic uses an API key only.
SUBSCRIPTION_CLI_ENABLED=false
# Portable default: PATH and common per-user/Hermes npm locations are auto-detected.
CODEX_COMMAND=codex
CODEX_MODEL=

# Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# OpenAI capabilities are detected when this key is configured locally.
OPENAI_API_KEY=
OPENAI_CHATGPT_MODEL=gpt-5.4-mini
OPENAI_SOL_MODEL=openai-sol-2026-07-20
OPENAI_IMAGE_MODEL=gpt-image-2

# Anthropic: required only for text.anthropic.fable
ANTHROPIC_API_KEY=
ANTHROPIC_FABLE_MODEL=claude-fable-5

# DeepSeek capabilities are detected when this key is configured locally.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# Higgsfield: explicit opt-in because generations may consume credits
HIGGSFIELD_ENABLED=false
HIGGSFIELD_COMMAND=higgsfield
HIGGSFIELD_GENJUTSU_MODEL_ID=
